{
  "name": "campusmarket",
  "version": "0.1.0",
  "private": true,
  "description": "CampusMarket 校园二手平台",
  "scripts": {
    "dev:weapp": "cross-env TARO_BUILD_TARGET=weapp TARO_APP_DATA_SOURCE=cloud taro build --type weapp --watch",
    "dev:h5": "cross-env TARO_BUILD_TARGET=h5 taro build --type h5 --watch",
    "build:weapp": "cross-env TARO_BUILD_TARGET=weapp TARO_APP_DATA_SOURCE=cloud taro build --type weapp",
    "build:h5": "cross-env TARO_BUILD_TARGET=h5 taro build --type h5",
    "typecheck": "tsc --noEmit",
    "test:cloud": "node --test cloudfunctions/market/*.test.js"
  },
  "dependencies": {
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "babel-preset-taro": "4.3.0",
    "cross-env": "^10.1.0",
    "react-refresh": "^0.14.2",
    "sass": "^1.77.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.25.0"
}